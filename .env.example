# Приложение на хосте использует localhost:5433 (порт наружу из docker-compose).
# При запуске приложения внутри docker compose используйте host=db и порт 5432.
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5433/masterflow_db

# Обязательно замените в production
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQL логирование (development)
SQL_ECHO=false